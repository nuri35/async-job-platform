  "scripts": {
    "build": "nest build",
    "build:worker": "nest build worker",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/async-job-platform/main",
    "start:worker": "nest start worker",
    "start:worker:dev": "nest start worker --watch",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "clean": "rimraf dist && node -e \"require('fs').readdirSync('.').filter(f=>f.startsWith('tmpclaude-')||f==='.claude').forEach(f=>require('fs').rmSync(f,{recursive:true,force:true}))\"",
    "clean:tmp": "node -e \"require('fs').readdirSync('.').filter(f=>f.startsWith('tmpclaude-')||f==='.claude').forEach(f=>require('fs').rmSync(f,{recursive:true,force:true}))\"",
    "push": "npm run clean:tmp && git push"
  },
